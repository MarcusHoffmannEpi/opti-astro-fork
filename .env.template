## The URL to the CMS, without the path (e.g. https://app-your_instance_id.cms.optimizely.com/)
OPTIMIZELY_CMS_URL=YOUR_CMS_DOMAIN

## Optimizely Graph Keys
OPTIMIZELY_GRAPH_SECRET=YOUR-SECRET-HERE
OPTIMIZELY_GRAPH_APP_KEY=YOUR-KEY-HERE
OPTIMIZELY_GRAPH_SINGLE_KEY=YOUR-KEY-HERE
OPTIMIZELY_GRAPH_GATEWAY=https://cg.optimizely.com

# Optimizely CMS API Gateway
OPTIMIZELY_CMS_API_GATEWAY=https://api.cms.optimizely.com/v1

## Optimizely API Client to manage Visual Builder styles
OPTIMIZELY_CLIENT_ID=YOUR-CLIENT-ID-HERE
OPTIMIZELY_CLIENT_SECRET=YOUR-CLIENT-SECRET-HERE

## Optimizely Data Platform settings
# OPTIMIZELY_DATA_PLATFORM_ENDPOINT=https://api.zaius.com
# OPTIMIZELY_DATA_PLATFORM_PRIVATE_KEY=YOUR-PRIVATE-KEY-HERE

## Optional performance settings
## If preview is not reliably updating when content is changed, set PREVIEW_DELAY to 750-1000 ms
# PREVIEW_DELAY=750

## External Preview
## Set to true and add a token to enable external preview link functionality
# EXTERNAL_PREVIEW_ENABLED=false
# EXTERNAL_PREVIEW_TOKEN=OptiPreview123

## Development Mode
## Set to true to show GraphQL query debug panel in footer during development
OPTIMIZELY_DEV_MODE=false

## Admin Dashboard Authentication
## HTTP Basic Authentication credentials for /admin route
## If not configured, the admin dashboard will return 404
# ADMIN_DASHBOARD_USERNAME=admin
# ADMIN_DASHBOARD_PASSWORD=your-secure-password-here

## Optimizely Feature Experimentation SDK
## Required for A/B testing and content variants
# OPTIMIZELY_FX_SDK_KEY=your-fx-sdk-key-here

## Optimizely CMP Preview Integration
## Required to enable CMP → CMS live preview via the content_preview_requested webhook.
##
## 1. Register the webhook in CMP:
##    Settings > Apps & Webhooks > Webhooks > Register New > General Webhook
##    Callback URL: https://<your-domain>/api/cmp-preview-webhook
##    Event:        content_preview_requested
##    Secret:       same value as CMP_WEBHOOK_SECRET below (max 32 chars)
# CMP_WEBHOOK_SECRET=your-secret-here
##
## 2. Create an OAuth app for machine-to-machine API calls:
##    Settings > Apps & Webhooks > Apps > Register New App
##    Grant type: Client Credentials
##    Copy the resulting client_id and client_secret below.
# CMP_CLIENT_ID=your-cmp-client-id
# CMP_CLIENT_SECRET=your-cmp-client-secret

## Sitemap Configuration
## Base URL for absolute URLs in sitemap.xml
## If not set, uses the request origin (e.g., https://localhost:4321)
## Set this in production to ensure consistent URLs across environments
# SITEMAP_BASE_URL=https://example.com