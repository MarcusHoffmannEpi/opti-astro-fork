---
/**
 * CMP Preview Page
 *
 * Fetches structured content directly from the CMP API and renders it using
 * the ArticlePage visual template. Called by CMP's preview iframe after the
 * webhook handler posts the signed URL via the complete endpoint.
 *
 * URL shape: /cmp-preview?content_id={id}&version_id={vid}&token={hmac}
 */

import { validateCmpPreviewToken } from '../lib/cmp-preview-utils';
import { fetchCmpContent, fetchCmpAssetUrl, getCmpTextField, getCmpRichTextField, getCmpAssetGuid } from '../lib/cmp-api';
import ArticlePageCmpPreview from '../cms/pages/ArticlePage/ArticlePageCmpPreview.astro';
import { CMP_WEBHOOK_SECRET } from 'astro:env/server';

const contentId = Astro.url.searchParams.get('content_id') ?? '';
const versionId = Astro.url.searchParams.get('version_id') ?? '';
const token     = Astro.url.searchParams.get('token') ?? '';

if (!contentId || !versionId || !token || !CMP_WEBHOOK_SECRET) {
    return Astro.redirect('/404', 404);
}

if (!validateCmpPreviewToken(contentId, versionId, token, CMP_WEBHOOK_SECRET as string)) {
    return Astro.redirect('/404', 404);
}

let cmpContent: any;
try {
    cmpContent = await fetchCmpContent(contentId, versionId);
} catch (err) {
    console.error('[CMP Preview] Failed to fetch content from CMP API:', err);
    return new Response(
        `<!doctype html><html><body style="font-family:sans-serif;padding:2rem">
            <p>Could not load preview — failed to fetch content from CMP.</p>
        </body></html>`,
        { status: 502, headers: { 'Content-Type': 'text/html' } }
    );
}

const fields = cmpContent?.content_body?.fields_version?.fields ?? {};
const locale = Astro.currentLocale ?? 'en';

const heading    = getCmpTextField(fields, 'heading');
const subHeading = getCmpTextField(fields, 'subHeading');
const author     = getCmpTextField(fields, 'author');
const bodyHtml   = getCmpRichTextField(fields, 'body');
const publishedDate = cmpContent?.content_body?.created_at ?? undefined;

// Resolve promo image CDN URL from CMP asset guid
const promoAssetGuid = getCmpAssetGuid(fields, 'promoImage');
const promoImageUrl  = promoAssetGuid ? await fetchCmpAssetUrl(promoAssetGuid) ?? undefined : undefined;
---

<ArticlePageCmpPreview
    heading={heading}
    subHeading={subHeading}
    author={author}
    bodyHtml={bodyHtml}
    promoImageUrl={promoImageUrl}
    publishedDate={publishedDate}
    locale={locale}
/>
