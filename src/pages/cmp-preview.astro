---
/**
 * CMP Preview Page
 *
 * Decodes content fields embedded directly in the URL by the webhook handler —
 * no CMP API calls needed here, keeping render time well under 10 seconds on
 * Vercel Hobby.
 *
 * URL shape: /cmp-preview?d={base64url-data}&s={hmac-sig}
 */

import { verifyPreviewData, decodePreviewData } from '../lib/cmp-preview-utils';
import ArticlePageCmpPreview from '../cms/pages/ArticlePage/ArticlePageCmpPreview.astro';
import { CMP_WEBHOOK_SECRET } from 'astro:env/server';

const encoded = Astro.url.searchParams.get('d') ?? '';
const sig     = Astro.url.searchParams.get('s') ?? '';

if (!encoded || !sig || !CMP_WEBHOOK_SECRET) {
    return Astro.redirect('/404', 404);
}

if (!verifyPreviewData(encoded, sig, CMP_WEBHOOK_SECRET as string)) {
    return Astro.redirect('/404', 404);
}

const { heading, subHeading, author, bodyHtml, publishedDate, promoImageUrl } = decodePreviewData(encoded);
const locale = Astro.currentLocale ?? 'en';
---

<ArticlePageCmpPreview
    heading={heading}
    subHeading={subHeading}
    author={author}
    bodyHtml={bodyHtml}
    promoImageUrl={promoImageUrl ?? undefined}
    publishedDate={publishedDate}
    locale={locale}
/>
