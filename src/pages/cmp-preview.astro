---
/**
 * CMP Preview Page
 *
 * Renders a CMS content item as a full-page preview for Optimizely CMP.
 * CMP loads this URL in its preview iframe after the webhook handler posts it
 * via the complete endpoint.
 *
 * URL shape: /cmp-preview?content_id={id}&version_id={vid}&token={hmac}
 *
 * The token is HMAC-SHA256(CMP_WEBHOOK_SECRET, content_id:version_id).
 * It is generated by the webhook handler and validated here before rendering.
 *
 * Content lookup: In Optimizely CMP+CMS integration the structured content_id
 * maps to the CMS content key. If your setup uses a different mapping, adjust
 * the `key` and `ver` values passed to contentById below.
 */

import type { Locales } from 'astro';
import { getOptimizelySdk } from '../graphql/getSdk';
import type { ContentPayload } from '../graphql/shared/ContentPayload';
import { localeToSdkLocale } from '../lib/locale-helpers';
import { validateCmpPreviewToken } from '../lib/cmp-preview-utils';
import Pages from '../cms/pages/_Pages.astro';
import Component from '../cms/components/_Component.astro';
import Experiences from '../cms/experiences/_Experiences.astro';
import { CMP_WEBHOOK_SECRET } from 'astro:env/server';

const contentId = Astro.url.searchParams.get('content_id') ?? '';
const versionId = Astro.url.searchParams.get('version_id') ?? '';
const token     = Astro.url.searchParams.get('token') ?? '';
const locale    = localeToSdkLocale(Astro.url.searchParams.get('loc') ?? Astro.currentLocale ?? 'en');

if (!contentId || !versionId || !token) {
    return Astro.redirect('/404', 404);
}

if (!validateCmpPreviewToken(contentId, versionId, token, CMP_WEBHOOK_SECRET)) {
    return Astro.redirect('/404', 404);
}

const cmpPayload: ContentPayload = {
    ctx: 'ext_preview',
    key: contentId,
    ver: versionId,
    loc: locale,
    preview_token: token,
    types: [],
};

const optiResponse = await getOptimizelySdk(cmpPayload).contentById({
    key: contentId,
    loc: locale as Locales,
    ver: versionId,
});

const rawTypes = optiResponse?._Content?.item?._metadata?.types ?? [];
const types = rawTypes.filter((t): t is string => t !== null);

if (types.length === 0) {
    return new Response(
        `<!doctype html><html><body style="font-family:sans-serif;padding:2rem">
            <p>Preview not yet available — content may still be syncing from CMP to CMS.</p>
        </body></html>`,
        { status: 200, headers: { 'Content-Type': 'text/html' } }
    );
}

cmpPayload.types = types;

const isComponent  = types.includes('_Component');
const isExperience = types.includes('_Experience');
const isPage       = types.includes('_Page') && !isExperience;
---

<>
    {isComponent  && <Component   data={cmpPayload} />}
    {isExperience && <Experiences data={cmpPayload} />}
    {isPage       && <Pages       data={cmpPayload} />}
</>
